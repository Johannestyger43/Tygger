<?php
require 'config.php';
$data = json_decode(file_get_contents('php://input'), true);
$resultCode = $data['Body']['stkCallback']['ResultCode'] ?? 1;
$checkoutId = $data['Body']['stkCallback']['CheckoutRequestID'] ?? '';
if ($resultCode === 0) {
    $stmt = $pdo->prepare("SELECT * FROM payments WHERE status='pending' ORDER BY id DESC LIMIT 1");
    $stmt->execute(); $p = $stmt->fetch();
    if ($p) {
        $pdo->prepare("UPDATE payments SET status='success', mpesa_code=? WHERE id=?")
            ->execute([$data['Body']['stkCallback']['CallbackMetadata']['Item'][1]['Value'] ?? '', $p['id']]);
